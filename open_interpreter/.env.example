# ── LLM Configuration ──────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Interpreter Behavior ────────────────────────────────────────
# Set to "true" to skip user confirmation before running code
AUTO_RUN=false

# Set to "true" to print debug information
DEBUG_MODE=false

# Max characters of code execution output to retain
MAX_OUTPUT_CHARS=2000

# LLM temperature (lower = more deterministic)
TEMPERATURE=0.01

# LLM provider: "openai" (default, also covers compatible APIs)
LLM_PROVIDER=openai
